# Переменные окружения сайта. Скопируйте в .env.local и заполните нужное.
# NEXT_PUBLIC_* вшиваются в браузерный бандл при сборке (next build) — после сборки их не поменять.
# Остальные читаются только на сервере, в браузер не попадают. Токены в репозиторий не коммитим.

# ── Статичное превью ─────────────────────────────────────────────
# 1 — сборка без сервера (GitHub Pages): форма не ходит в /api/lead и сразу показывает «Заявка принята» с пометкой «демо».
NEXT_PUBLIC_STATIC_DEMO=

# ── Яндекс Метрика ──────────────────────────────────────────────
# Номер счётчика. Пусто — Метрика не грузится. Грузится только после согласия на аналитику в cookie-баннере.
# Цели заводим в Метрике как «JavaScript-событие»: lead_sent (заявка отправлена), form_start (начали заполнять форму).
NEXT_PUBLIC_YM_ID=

# ── Яндекс SmartCaptcha (невидимая) ─────────────────────────────
# Ключ клиента: виджет грузится, только когда сервер счёл отправку подозрительной.
NEXT_PUBLIC_SMARTCAPTCHA_KEY=
# Ключ сервера: без него капча выключена, подозрительные отправки (заполнили быстрее LEAD_MIN_FILL_MS) отклоняются.
SMARTCAPTCHA_SERVER_KEY=
# 1 — требовать капчу на каждой отправке, а не только при подозрении (на случай спам-атаки).
LEAD_CAPTCHA_ALWAYS=

# ── Онлайн-чат Битрикс24 ─────────────────────────────────────────
# Ссылка на загрузчик виджета: Битрикс24 → Контакт-центр → Виджет на сайт → код установки, адрес из src скрипта
# (вида https://cdn-ru.bitrix24.ru/b1234567/crm/site_button/loader_1_abcdef.js). Пусто — своя кнопка чата с мессенджерами.
NEXT_PUBLIC_B24_WIDGET_URL=

# ── Защита формы ─────────────────────────────────────────────────
# Сколько заявок можно отправить с одного IP за окно (скользящее окно, счётчик в памяти процесса).
LEAD_RATE_LIMIT=6
LEAD_RATE_WINDOW_SEC=600
# Минимальное время от показа формы до отправки, мс. Быстрее — бот.
LEAD_MIN_FILL_MS=3000
# Повтор с того же телефона за это время считаем двойным кликом и не отправляем второй раз, с.
LEAD_DOUBLE_SEC=60
# Дополнительные адреса, с которых принимаем заявки (кроме своего хоста и car-city.pro), через запятую.
# Например, превью: https://preview.car-city.pro
LEAD_ALLOWED_ORIGINS=
# IP берётся из X-Real-IP / X-Forwarded-For: сайт должен стоять за балансировщиком, который их перезаписывает.

# ── Доставка заявок ──────────────────────────────────────────────
# Каждый канал включается своими переменными; заявка уходит во все включённые параллельно.
# Если не принял ни один канал — посетитель видит ошибку с телефоном офиса. В продакшене без каналов форма отвечает ошибкой.
# Полный телефон уходит только в каналы; в логи пишется маска (+7999***67).

# Telegram: бот от @BotFather, бот добавлен в чат менеджеров.
TELEGRAM_BOT_TOKEN=
# ID чата (у групп начинается с -100), можно несколько через запятую.
TELEGRAM_CHAT_ID=
# Тема в группе-форуме (message_thread_id), если заявки идут в отдельную тему.
TELEGRAM_THREAD_ID=

# Bitrix24: входящий вебхук с правом crm, вида https://portal.bitrix24.ru/rest/1/xxxxxxxx/
# Заявка создаётся методом crm.lead.add с UTM и комментарием со всем контекстом.
BITRIX24_WEBHOOK_URL=
# Источник лида в Bitrix24 (справочник «Источники»), по умолчанию WEB.
BITRIX24_SOURCE_ID=

# Своя CRM / любой приёмник: POST JSON {"type":"lead","lead":{...}} — все поля заявки, метки входа, согласие.
LEAD_WEBHOOK_URL=
# Секрет подписи: заголовок X-Signature: sha256=<HMAC-SHA256 тела в hex>. CRM проверяет подпись.
LEAD_WEBHOOK_SECRET=
